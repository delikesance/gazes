{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/subtitle-assets.mjs && next dev --webpack -p 4389",
    "build": "node scripts/subtitle-assets.mjs && next build",
    "start": "next start -p 4389",
    "lint": "eslint",
    "test:skip": "node --test scripts/skip-segments.test.mjs",
    "test:files": "node scripts/episode-file.test.mjs",
    "test:seasons": "node scripts/season-flow.mjs",
    "test:player": "node scripts/subtitle-assets.mjs && node scripts/player-subtitles.test.mjs",
    "test:player:fullscreen": "node scripts/player-fullscreen.test.mjs",
    "test:subtitles:windows": "node scripts/subtitle-window.test.mjs",
    "test:sources": "node scripts/playback-sources.test.mjs && node scripts/auto-playback.test.mjs",
    "test:design": "node scripts/design-flow.mjs",
    "test:hero": "node scripts/featured-hero.test.mjs",
    "test:tracks": "node scripts/media-tracks.test.mjs",
    "test:i18n": "node scripts/i18n-flow.mjs",
    "test:auth": "node scripts/auth-envelope.test.mjs",
    "test:calendar": "node scripts/calendar.test.mjs",
    "test:library": "node --experimental-strip-types scripts/library.test.mjs",
    "test:vf": "node --experimental-strip-types scripts/vf-evidence.test.mjs",
    "diagnostic:naruto-vf": "node --experimental-strip-types scripts/naruto-vf-diagnostic.mjs",
    "test:vf:player": "node scripts/vf-player.test.mjs",
    "diagnostic:sources": "node --experimental-strip-types scripts/source-audit.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@noble/post-quantum": "^0.7.1",
    "clsx": "^2.1.1",
    "hls.js": "1.7.3",
    "jassub": "2.5.16",
    "libpgs": "^0.9.0",
    "lucide-react": "^1.49.0",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.25.0"
}
