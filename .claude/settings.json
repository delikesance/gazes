{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/home/workstation/.local/bin/graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/home/workstation/.local/bin/graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(make check)",
      "Bash(make lint*)",
      "Bash(make test*)",
      "Bash(make typecheck)",
      "Bash(make build*)",
      "Bash(go build*)",
      "Bash(go vet*)",
      "Bash(go test*)",
      "Bash(gofmt*)",
      "Bash(graphify *)",
      "Bash(rtk *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git worktree list*)",
      "Bash(pnpm run lint*)",
      "Bash(pnpm run test*)",
      "Bash(pnpm exec tsc*)",
      "Bash(pnpm run build)",
      "Bash(pnpm exec eslint*)",
      "Bash(pnpm exec next*)",
      "Bash(node scripts/*)",
      "Bash(curl -s* localhost:*)",
      "Bash(git pull --ff-only*)",
      "Bash(git rev-parse*)",
      "Bash(git show*)",
      "Bash(rg *)",
      "Bash(fd *)",
      "Bash(jq *)",
      "Bash(git switch*)",
      "Bash(git checkout -b*)",
      "Bash(git push -u origin*)",
      "Bash(git merge*)",
      "Bash(git branch -d*)",
      "Bash(git worktree*)",
      "mcp__gazes__get_overview",
      "mcp__gazes__get_errors_summary",
      "mcp__gazes__get_player_health",
      "mcp__gazes__get_sources_health",
      "mcp__gazes__list_playback_errors",
      "mcp__gazes__get_retention",
      "mcp__gazes__get_funnel",
      "mcp__gazes__get_views",
      "mcp__gazes__get_growth",
      "mcp__gazes__get_costs",
      "mcp__gazes__list_top_anime",
      "mcp__gazes__get_watch_status",
      "mcp__gazes__list_issues",
      "mcp__gazes__get_issue",
      "mcp__gazes__create_issue",
      "mcp__gazes__add_note",
      "mcp__gazes__get_approval"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(git push origin --delete main*)",
      "Bash(git push origin --delete dev*)",
      "Bash(docker compose down -v*)",
      "Read(./web/.next*/**)",
      "Read(./web/node_modules/**)",
      "Read(./web/tsconfig.tsbuildinfo)",
      "Read(./web/pnpm-lock.yaml)",
      "Read(./go.sum)",
      "Read(./web/public/subtitles/**)",
      "Read(./graphify-out/cache/**)",
      "Read(~/.config/forgejo/**)"
    ]
  },
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "12000",
    "MAX_MCP_OUTPUT_TOKENS": "8000",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "MAX_THINKING_TOKENS": "8000"
  },
  "model": "sonnet"
}